# EcoCash Production Environment Variables
# Copy this to .env and fill in your actual values

# Flask configuration
FLASK_SECRET=your-random-secret-key-here

# Telegram Bot (required)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ADMIN_ID=your-telegram-user-id

# Deployment URL (set this after deploying to Render)
BASE_URL=https://your-render-url.onrender.com

# Admin panel password (change this!)
ADMIN_PASSWORD=admin1234

# Africa's Talking API (optional)
AT_API_KEY=optional_africas_talking_key

# Server port (Render sets this automatically)
PORT=5000
